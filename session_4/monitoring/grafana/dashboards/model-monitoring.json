{
  "uid": "session4-model-monitoring",
  "title": "Ride Duration — Model Monitoring",
  "description": "Four rows, in the order you read them during an incident: Service (what the caller feels) → Resources (what is saturating) → Model behaviour (what the model is saying) → Quality & drift (is it still right). Provisioned as code from monitoring/grafana/dashboards/model-monitoring.json — edits made in the UI are overwritten within 30s, so change the file.",
  "tags": [
    "mlops",
    "session-4",
    "drift",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"model-api\"}, model)",
          "refId": "model"
        },
        "definition": "label_values(up{job=\"model-api\"}, model)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {},
        "options": [],
        "description": "One dashboard for every model, instead of twelve near-identical copies nobody maintains. The label comes from the scrape target in prometheus.yml, so a new model needs no dashboard edit."
      },
      {
        "name": "city",
        "label": "City",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(model_mae_minutes, city)",
          "refId": "city"
        },
        "definition": "label_values(model_mae_minutes, city)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "description": "Segment selector for the MAE panel. refresh=2 (on time range change) because a NEW city appearing is itself the signal — incident 05 is a city that was not in the list yesterday."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "increase(deploy_events_total[$__rate_interval]) > 0",
        "step": "60s",
        "titleFormat": "Deploy",
        "textFormat": "{{component}}",
        "tagKeys": "component",
        "target": {
          "refId": "Anno",
          "expr": "increase(deploy_events_total[$__rate_interval]) > 0"
        }
      },
      {
        "name": "Retrains",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "increase(retrain_events_total[$__rate_interval]) > 0",
        "step": "60s",
        "titleFormat": "Retrain",
        "textFormat": "{{decision}}",
        "tagKeys": "decision",
        "target": {
          "refId": "Anno",
          "expr": "increase(retrain_events_total[$__rate_interval]) > 0"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service — what the caller experiences",
      "description": "RED method: Rate, Errors, Duration. Everything here is a SYMPTOM, which is why the alerts on this row page and the rest only warn.",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "description": "Counted by middleware, not by the handler, so a request rejected before the handler body still appears. /metrics is excluded — scrape traffic is not user traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, status) (rate(api_requests_total{model=\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} · {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "Three quantiles, never a mean. A mean latency of 120ms hides the 1% of callers waiting two seconds, and those are the ones who complain. PredictLatencyP95High fires off the p95 line at 0.5s.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_latency_seconds_bucket{model=\"$model\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{model=\"$model\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_latency_seconds_bucket{model=\"$model\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate (%)",
      "description": "Non-2xx as a share of all requests. This panel was impossible before api_requests_total existed: the latency histogram is only observed inside the handler with status=\"200\" hardcoded, so an error rate derived from it is a flat zero no matter how badly the service is failing.",
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(api_requests_total{model=\"$model\",status!~\"2..\"}[$__rate_interval])) / sum(rate(api_requests_total{model=\"$model\"}[$__rate_interval]))",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Target",
      "description": "up{} is synthesised by Prometheus, not exported by the service — which is the point: a dead process cannot report that it is dead.",
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"model-api\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Resources — saturation, before anyone feels it",
      "description": "Two sources on purpose. api_process_* is the model server itself (psutil, on the host). node_* is the machine under it (node-exporter) — on Docker Desktop that machine is the Linux VM, not your laptop. Only the first one wakes you up.",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model process · CPU",
      "description": "Percent of ONE core, as psutil reports it: 100% means one core saturated, and this box has more than one. Sampled at scrape time — nothing else would ever move it.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "api_process_cpu_percent{model=\"$model\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model process · resident memory",
      "description": "RSS only. Virtual size is also exported but on macOS it reads ~445GB of address space and means nothing. A line climbing steadily across a week is a leak you can schedule; the same line hitting the OOM killer at 3am is an incident.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "api_process_memory_bytes{model=\"$model\",type=\"rss\"}",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Host / VM · CPU busy",
      "description": "Derived from idle time because that is the only mode guaranteed to exist on every platform. On Docker Desktop this is the Linux VM's allocated cores, not your Mac's.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)",
          "legendFormat": "busy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host / VM · memory used",
      "description": "MemAvailable, not MemFree. MemFree looks alarming on any healthy Linux box because the kernel spends free memory on page cache; MemAvailable is the kernel's own estimate of what a new process could actually get.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk free on the log volume — with the 4h projection",
      "description": "The second series IS the DiskFillPredicted alert, drawn. A disk at 85% tells you nothing; a disk losing 4GB/hour tells you when it dies. When the projection crosses zero you have four hours, and that is a ticket rather than an outage. Measured by the service on the host path, not from node_filesystem_* — inside Docker Desktop that reports the VM's synthetic mounts, not your real volume.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "disk_free_bytes{model=\"$model\"}",
          "legendFormat": "free · {{path}}"
        },
        {
          "refId": "B",
          "expr": "predict_linear(disk_free_bytes{model=\"$model\"}[6h], 4 * 3600)",
          "legendFormat": "projected in 4h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Model process · file descriptors and threads",
      "description": "The classic slow leak. Descriptors that climb and never fall mean something is not being closed, and the failure lands as 'Too many open files' hours later, in code that has nothing to do with the bug.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "api_process_open_fds{model=\"$model\"}",
          "legendFormat": "open fds"
        },
        {
          "refId": "B",
          "expr": "api_process_threads{model=\"$model\"}",
          "legendFormat": "threads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Samples per scrape vs sample_limit",
      "description": "The cardinality budget, drawn. prometheus.yml sets sample_limit: 5000, and a scrape ABOVE it is rejected whole — the target goes down and takes every panel with it. A healthy scrape here is ~30 samples; incident 04 walks this line to the threshold in about two minutes. This is saturation of the monitoring system itself, which is why it sits in Resources.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_scraped{job=\"model-api\"}",
          "legendFormat": "samples"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Model behaviour — what the model is saying",
      "description": "A REGRESSOR predicting minutes. There is no score distribution and no positive rate here because there is no score and no positive class: the output distribution is a histogram of minutes, and its tail is the early warning.",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "heatmap",
      "title": "Predicted duration distribution (minutes)",
      "description": "The output distribution, which moves before accuracy does — you see it shift here days before a late label proves it. Bands shifting upward without a matching shift in inputs is the signature of incident 02, a stale transform on a healthy model.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(model_prediction_duration_min_bucket{model=\"$model\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "unit": "m"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Long-ride rate (> 60 min), %",
      "description": "The regression answer to 'positive rate'. There is no positive class to count, so the equivalent early-warning signal is the share of predictions in the tail. It is computed from the le=\"60.0\" bucket — note the \"60.0\": le is a STRING label and le=\"60\" matches nothing, silently.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(rate(model_prediction_duration_min_bucket{model=\"$model\",le=\"60.0\"}[$__rate_interval])) / sum(rate(model_prediction_duration_min_count{model=\"$model\"}[$__rate_interval]))))",
          "legendFormat": "> 60 min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
