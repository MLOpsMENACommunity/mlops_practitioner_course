# Local environments: .venv is the main stack, .venv-edge holds onnx2tf + LiteRT,
# whose exact pins (onnx 1.20.1, onnxruntime 1.26.0) conflict with the main stack.
.venv/
.venv-edge/

# Generated by `make data` — deterministic, regenerated in seconds, never committed.
data/synthetic/
data/ccpd/

# Trained checkpoints, exported graphs, engines, IR, traces. Hardware-specific or large;
# `make train` and the stage targets rebuild all of it. results/ IS committed.
artifacts/
*.engine
*.plan
*.tflite

# Model files inside the Triton repository are copied in by `make s11`; the
# config.pbtxt files and the Python backends next to them are committed.
triton_serving/model_repository/*/[0-9]*/*.onnx
triton_serving/model_repository/*/[0-9]*/*.plan

# Temporary external-data files the ONNX exporter leaves in the working directory when an export
# raises mid-way (tens of MB of raw weights). Never results, never committed.
/*.data
